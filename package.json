{
  "name": "mithril-lynx-ui",
  "version": "0.0.1",
  "description": "A component library for mithril-lynx apps, visually identical to @lynx-js/lynx-ui (same Luna CSS tokens) \u2014 components ported/rebuilt for Mithril's component model instead of ReactLynx.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlos-sweb/mithril-lynx-ui.git"
  },
  "homepage": "https://github.com/carlos-sweb/mithril-lynx-ui#readme",
  "bugs": {
    "url": "https://github.com/carlos-sweb/mithril-lynx-ui/issues"
  },
  "exports": {
    "./styles.css": "./styles.css",
    "./scope": {
      "types": "./scope.d.ts",
      "default": "./scope.js"
    },
    "./button": {
      "types": "./button.d.ts",
      "default": "./button.js"
    },
    "./switch": {
      "types": "./switch.d.ts",
      "default": "./switch.js"
    },
    "./checkbox": {
      "types": "./checkbox.d.ts",
      "default": "./checkbox.js"
    },
    "./radio-group": {
      "types": "./radio-group.d.ts",
      "default": "./radio-group.js"
    },
    "./native": {
      "types": "./internal/native.d.ts",
      "default": "./internal/native.js"
    },
    "./presence": {
      "types": "./presence.d.ts",
      "default": "./presence.js"
    },
    "./input": {
      "types": "./input.d.ts",
      "default": "./input.js"
    },
    "./draggable": {
      "types": "./draggable.d.ts",
      "default": "./draggable.js"
    }
  },
  "files": [
    "css",
    "internal",
    "styles.css",
    "scope.js",
    "scope.d.ts",
    "button.js",
    "button.d.ts",
    "switch.js",
    "switch.d.ts",
    "checkbox.js",
    "checkbox.d.ts",
    "radio-group.js",
    "radio-group.d.ts",
    "NOTICE",
    "presence.js",
    "presence.d.ts",
    "input.js",
    "input.d.ts",
    "draggable.js",
    "draggable.d.ts"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "test": "rstest run"
  },
  "peerDependencies": {
    "mithril": "2.3.8",
    "mithril-lynx": "^0.0.4"
  },
  "dependencies": {
    "@lynx-js/luna-styles": "^0.2.2"
  },
  "devDependencies": {
    "mithril": "2.3.8",
    "mithril-lynx": "^0.0.4",
    "@lynx-js/testing-environment": "npm:@lynx-js/testing-environment-canary@0.3.2-canary-20260803-5a891c73",
    "@lynx-js/type-element-api": "0.0.9",
    "@lynx-js/types": "4.1.0",
    "@rstest/core": "^0.11.3",
    "@types/mithril": "^2.2.9",
    "jsdom": "^28.0.0",
    "typescript": "~6.0.3"
  }
}
